rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Posts collection
    match /posts/{postId} {
      // Allow read for everyone (including visitors)
      allow read: if true;
      
      // Allow write only for admin
      allow write: if isAdmin();
    }

    // Reactions collection
    match /reactions/{reactionId} {
      // Allow read for everyone (including visitors)
      allow read: if true;
      
      // Allow create for authenticated users acting only as themselves
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'postId',
          'emoji',
          'userId',
          'userName',
          'createdAt',
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.emoji is string
        && request.resource.data.userName is string
        && request.resource.data.createdAt is timestamp;
      
      // Allow delete only for the reaction owner or admin
      allow delete: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      
      // Deny updates
      allow update: if false;
    }
  }
}
